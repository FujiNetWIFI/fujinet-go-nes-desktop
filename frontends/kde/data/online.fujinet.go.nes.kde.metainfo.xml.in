<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>online.fujinet.go.nes.kde</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>FujiNet Go NES (KDE)</name>
  <summary>An NES with a built-in FujiNet</summary>
  <description>
    <p>
      A self-contained NES with a FujiNet built in: browse a network
      host from the console, boot cartridges over the network, and let the
      booted program keep talking to the network, all in one application.
    </p>
    <p>
      The emulator is MesenCE, with the FujiNet NES cartridge running the
      real cartridge firmware's own protocol sources and mapper engine, so it
      behaves exactly as the hardware does: CONFIG starts through the
      cartridge's loader, games booted over the network are copied into its
      SRAMs, and a local .nes file can be opened in place of CONFIG. Both
      controllers are on screen and remappable, gamepads are picked up as
      they are plugged in, and a native debugger built on Mesen's own engine
      is a key press away.
    </p>
    <p>
      The Famicom expansion port takes a keyboard: the Family BASIC
      Keyboard, with its Data Recorder for saving and loading programs on
      tape files, or the Subor keyboard. Type on the computer's keyboard or
      click the on-screen one.
    </p>
    <p>
      Nothing copyrighted is included: the NES has no system ROM, and
      the only built-in program is FujiNet's own CONFIG client.
    </p>
  </description>
  <launchable type="desktop-id">online.fujinet.go.nes.kde.desktop</launchable>
  <icon type="stock">online.fujinet.go.nes.kde</icon>
  <!-- Software centres classify from these, not from the .desktop
       Categories= line; without them the app lands in no section at all. -->
  <categories>
    <category>Game</category>
    <category>Emulator</category>
  </categories>
  <url type="homepage">https://fujinet.online/</url>
  <url type="bugtracker">https://github.com/FujiNetWIFI/fujinet-go-nes-desktop/issues</url>
  <screenshots>
    <screenshot type="default">
      <caption>FujiNet CONFIG running on the emulated NES</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-nes-desktop/v0.2.1/data/screenshots/kde/1_config.png</image>
    </screenshot>
    <screenshot>
      <caption>The built-in debugger's live disassembly</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-nes-desktop/v0.2.1/data/screenshots/kde/2_debugger.png</image>
    </screenshot>
    <screenshot>
      <caption>Preferences</caption>
      <image>https://raw.githubusercontent.com/FujiNetWIFI/fujinet-go-nes-desktop/v0.2.1/data/screenshots/kde/3_preferences.png</image>
    </screenshot>
  </screenshots>
  <developer id="online.fujinet">
    <name>FujiNet</name>
  </developer>
  <content_rating type="oars-1.1"/>
  <releases>
    <!-- The CURRENT release templates its version from @PROJECT_VERSION@, so
         it cannot disagree with the tree; past releases are literal. The
         release job checks that this first entry is still a template. -->
    <release version="@PROJECT_VERSION@" date="2026-10-29">
      <description>
        <p>
          New: use an external FujiNet. A switch in Preferences makes the app connect to another FujiNet instance at a host:port you enter (for example 127.0.0.1:11506) instead of starting the built-in one.
        </p>
      </description>
    </release>
    <release version="0.2.2" date="2026-10-27">
      <description>
        <p>
          The Flatpak bundles now name Flathub as their runtime repository, so a downloaded bundle can fetch the GNOME or KDE runtime on a machine that has not set up Flathub.
        </p>
      </description>
    </release>
    <release version="0.2.1" date="2026-10-27">
      <description>
        <p>
          The Flatpak builds on the GNOME 51 runtime. The software-centre
          listing now credits FujiNet as developer, declares the app icon,
          names each frontend (GNOME or KDE), and shows a full set of
          screenshots for each.
        </p>
      </description>
    </release>
    <release version="0.2.0" date="2026-10-19">
      <description>
        <p>
          Debugger: a FujiNet tab shows every FujiBus packet between the NES
          cartridge and FujiNet, both ways, with hex.
        </p>
      </description>
    </release>
    <release version="0.1.4" date="2026-10-19">
      <description>
        <p>
          A new icon in the NES console's own colours: the FujiNet mark in
          Nintendo red on the console's two-tone grey.
        </p>
      </description>
    </release>
    <release version="0.1.3" date="2026-10-05">
      <description>
        <p>
          The FujiNet web UI opens in the system browser instead of an
          embedded web view, so its Google and OneDrive Authorize buttons
          work: they open the provider's consent page in a new tab, and the
          web UI notices when authorization completes.
        </p>
      </description>
    </release>
    <release version="0.1.2" date="2026-10-05">
      <description>
        <p>
          CONFIG's HOST SLOTS can boot the game lobby, and shows the FujiNet
          logo; the file browser shows the logo faded behind the list and a
          scroll bar. The cartridge's FujiNet signature no longer reads
          back as zero after the first transaction.
        </p>
      </description>
    </release>
    <release version="0.1.1" date="2026-10-04">
      <description>
        <p>
          CONFIG's LOADING bar now fills as the game is pushed to the
          cartridge, instead of sitting at 0% and jumping to 100% at boot.
        </p>
      </description>
    </release>
    <release version="0.1.0" date="2026-10-04">
      <description>
        <p>
          First release: MesenCE with the FujiNet NES cartridge, an
          in-process FujiNet, native GNOME, KDE, macOS and Windows frontends,
          both controllers on screen, hotplugged gamepads, Reset Game and
          Reset to CONFIG, and a native debugger.
        </p>
      </description>
    </release>
  </releases>
</component>
